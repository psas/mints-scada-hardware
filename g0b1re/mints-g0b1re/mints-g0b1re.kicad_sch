	(text "Configuration Instructions\nFor 0-3.3V:\n	R_ADC_TOP: 0\n	R_ADC_BTM: NP\n	R_ADC_POS: 1k\n	R_ADC_NEG: 1k\n\nFor 0-33V:\n	R_ADC_TOP: 100k\n	R_ADC_BOT: 11k\n	R_ADC_POS: 0\n	R_ADC_NEG: 1k\n\nFor 4-20mA:\n	R_ADC_TOP: 0\n	R_ADC_BOT: 10\n	R_ADC_POS: 1k\n	R_ADC_NEG: 1k\n\nFor higher amps:\n	R_ADC_TOP: 0\n	R_ADC_BOT: NP\n	R_ADC_POS: 1k\n	R_ADC_NEG: 1k\n	R_SHUNT  : shunt"
